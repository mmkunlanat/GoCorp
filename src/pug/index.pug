        // Navigation
        nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.sticky-top.shadow-sm
            .container.px-4.px-lg-5
                a.navbar-brand.d-flex.align-items-center(href='#!')
                    i.bi.bi-car-front-fill.text-primary.fs-4.me-2
                    span.fw-bold GoCorp
                    span.badge.bg-primary.ms-2.fw-normal.small ยานพาหนะ
                button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarSupportedContent' aria-controls='navbarSupportedContent' aria-expanded='false' aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                #navbarSupportedContent.collapse.navbar-collapse
                    ul.navbar-nav.me-auto.mb-2.mb-lg-0.ms-lg-4
                        li.nav-item
                            a.nav-link.active(aria-current='page' href='#!')
                                i.bi.bi-house-door-fill.me-1
                                | หน้าแรก
                        li.nav-item
                            a.nav-link(href='#fleetSection')
                                i.bi.bi-grid-fill.me-1
                                | รายการรถยนต์
                        li.nav-item
                            a.nav-link(href='#!', data-bs-toggle='modal', data-bs-target='#selectedFleetModal')
                                i.bi.bi-journal-check.me-1
                                | ประวัติการเดินทาง & เบิกเงิน
                    form.d-flex
                        button.btn.btn-outline-light.position-relative(type='button', data-bs-toggle='modal', data-bs-target='#selectedFleetModal')
                            i.bi.bi-speedometer2.me-1.text-warning
                            | รถที่กำลังใช้งาน
                            span#cartCountBadge.badge.bg-light.text-dark.ms-2.rounded-pill 0

        // Header / Hero Section
        header.fleet-hero.py-5
            .container.px-4.px-lg-5.my-4
                .row.align-items-center
                    .col-lg-8.text-white
                        .hero-badge.mb-3
                            i.bi.bi-shield-check.me-2
                            | ระบบบริหารจัดการยานพาหนะส่วนกลาง GoCorp
                        h1.display-5.fw-bold.mb-3 ระบบเลือกใช้งานรถยนต์
                        p.lead.fw-normal.text-white-50.mb-4
                            | ตรวจสอบหมายเลขทะเบียนรถยนต์ รอบต่อภาษี รอบการซ่อมบำรุง บันทึกเลขไมล์ก่อนและหลังใช้รถ พร้อมคำนวณเงินชดเชยค่าเดินทางอัตโนมัติตามระยะทางจริง
                    .col-lg-4.mt-4.mt-lg-0
                        .row.g-3
                            .col-6
                                .stats-card
                                    .stats-number 8
                                    .stats-label รถทั้งหมดในสังกัด
                            .col-6
                                .stats-card
                                    .stats-number.text-success 6
                                    .stats-label พร้อมใช้งาน
                            .col-6
                                .stats-card
                                    .stats-number.text-warning 1
                                    .stats-label ติดภารกิจ
                            .col-6
                                .stats-card
                                    .stats-number.text-danger 1
                                    .stats-label ซ่อมบำรุง

        // Filter and Search Section
        .container.px-4.px-lg-5
            .filter-search-card
                .row.g-3.align-items-center
                    .col-lg-5
                        .search-input-group
                            i.bi.bi-search.search-icon
                            input#vehicleSearchInput.form-control(type='text', placeholder='ค้นหาด้วยเลขทะเบียนรถ หรือ ยี่ห้อ/รุ่นรถ...')
                    .col-lg-7
                        .d-flex.flex-wrap.gap-2.justify-content-lg-end
                            button.filter-btn.active(type='button', data-filter='all') ทั้งหมด
                            button.filter-btn(type='button', data-filter='sedan') รถเก๋ง
                            button.filter-btn(type='button', data-filter='van') รถตู้
                            button.filter-btn(type='button', data-filter='suv') SUV
                            button.filter-btn(type='button', data-filter='pickup') รถกระบะ
                            button.filter-btn(type='button', data-filter='ev') รถยนต์ไฟฟ้า (EV)

        // Main Vehicle Section
        section#fleetSection.py-5
            .container.px-4.px-lg-5
                .d-flex.justify-content-between.align-items-center.mb-4
                    div
                        h3.fw-bold.mb-1 รายการยานพาหนะทั้งหมด
                        p.text-muted.mb-0 แสดงเลขทะเบียนรถ รอบต่อภาษีประจำปี รอบเช็กระยะซ่อมบำรุง และระบบคำนวณค่าเดินทาง
                    span.badge.bg-primary-subtle.text-primary.border.border-primary-subtle.px-3.py-2
                        i.bi.bi-check2-circle.me-1
                        | คลิก "เลือกใช้งาน" เพื่อเริ่มบันทึกการเดินทาง

                // Vehicle Cards Grid
                #vehicleGrid.row.gx-4.gx-lg-5.row-cols-1.row-cols-md-2.row-cols-xl-4.justify-content-center
                    each car in vehicles
                        .col.mb-5.car-item(data-id=car.id, data-category=car.category, data-plate=car.plateNumber, data-name=car.name, data-status=car.status)
                            .card.h-100.car-card.shadow-sm
                                if car.status === 'available'
                                    .badge.bg-success.text-white.position-absolute.card-status-badge
                                        i.bi.bi-check-circle-fill.me-1
                                        | #{car.statusText}
                                else if car.status === 'in-use'
                                    .badge.bg-warning.text-dark.position-absolute.card-status-badge
                                        i.bi.bi-clock-history.me-1
                                        | #{car.statusText}
                                else
                                    .badge.bg-danger.text-white.position-absolute.card-status-badge
                                        i.bi.bi-tools.me-1
                                        | #{car.statusText}

                                // ป้ายทะเบียนรถยนต์แสดงเป็นตัวหนังสือแทนรูปภาพ
                                .car-plate-wrapper
                                    .thai-license-plate(class=car.plateType)
                                        .plate-bolt.plate-bolt-left
                                        .plate-bolt.plate-bolt-right
                                        .plate-inner-border
                                            span.plate-dlt-seal ขส
                                            .plate-number= car.plateNumber
                                            .plate-province= car.province

                                // รายละเอียดรถยนต์ (ดีไซน์กระชับ สวยงาม ไม่เทอะทะ)
                                .card-body.p-3.d-flex.flex-column
                                    // แถวที่ 1: ชื่อรุ่นรถ และ ป้ายประเภท
                                    .d-flex.align-items-start.justify-content-between.mb-1
                                        h6.fw-bold.car-name.mb-0.text-truncate(title=car.name)= car.name
                                        span.badge.bg-light.text-dark.border.small.flex-shrink-0.ms-2= car.categoryName

                                    // แถวที่ 2: ช่องจอด และ เลขไมล์ล่าสุด
                                    .d-flex.align-items-center.justify-content-between.small.text-muted.mb-2
                                        span
                                            i.bi.bi-geo-alt-fill.text-danger.me-1
                                            | #{car.parking}
                                        span.fw-semibold.text-dark
                                            i.bi.bi-speedometer2.text-primary.me-1
                                            | #{car.currentMileage.toLocaleString()} กม.

                                    // แถวที่ 3: สเปกย่อแบบ Chip เรียบหรู
                                    .compact-specs-row.mb-2
                                        span.spec-chip
                                            i.bi.bi-people-fill.text-primary.me-1
                                            | #{car.seats}
                                        span.spec-chip
                                            i.bi.bi-gear-fill.text-primary.me-1
                                            | #{car.transmission}
                                        span.spec-chip
                                            i.bi.bi-fuel-pump-fill.text-primary.me-1
                                            | #{car.fuel}

                                    // แถวที่ 4: แสดงแจ้งเตือนภาษีหรือซ่อมบำรุงเฉพาะคันที่ใกล้ถึงกำหนด (แบบแถบกระชับ)
                                    if car.taxAlert || car.maintAlert
                                        .my-1
                                            if car.taxAlert
                                                .compact-alert-pill.alert-tax.mb-1
                                                    i.bi.bi-exclamation-triangle-fill.me-1
                                                    span.text-truncate ภาษีหมด: <strong>#{car.taxDue}</strong>
                                                    span.badge.bg-danger.ms-auto= car.taxStatus.replace('ใกล้ถึงกำหนด ', '')
                                            if car.maintAlert
                                                .compact-alert-pill.alert-maint
                                                    i.bi.bi-wrench-adjustable.me-1
                                                    span.text-truncate เช็กระยะ: <strong>#{car.maintenanceDue.split(' (')[0]}</strong>
                                                    span.badge.bg-warning.text-dark.ms-auto= car.maintenanceStatus.replace('ปกติ ', '')
                                    else
                                        .small.text-muted.my-1.d-flex.align-items-center
                                            i.bi.bi-check-circle-fill.text-success.me-1
                                            | ภาษี & เช็กระยะ: ปกติ

                                // ปุ่มเลือกใช้งาน
                                .card-footer.px-3.pb-3.pt-0.border-top-0.bg-transparent
                                    if car.status === 'available'
                                        button.btn.btn-primary.btn-sm.w-100.py-2.fw-semibold.rounded-3.btn-select-car(type='button', 
                                            data-id=car.id, 
                                            data-plate=car.plateNumber, 
                                            data-name=car.name, 
                                            data-province=car.province, 
                                            data-category=car.categoryName, 
                                            data-parking=car.parking, 
                                            data-platetype=car.plateType,
                                            data-mileage=car.currentMileage,
                                            data-tax=car.taxDue,
                                            data-maintenance=car.maintenanceDue)
                                            i.bi.bi-car-front-fill.me-1
                                            | เลือกใช้งานรถคันนี้
                                    else if car.status === 'in-use'
                                        button.btn.btn-outline-secondary.btn-sm.w-100.py-2(type='button', disabled)
                                            i.bi.bi-clock-history.me-1
                                            | กำลังติดภารกิจ
                                    else
                                        button.btn.btn-outline-danger.btn-sm.w-100.py-2(type='button', disabled)
                                            i.bi.bi-tools.me-1
                                            | อยู่ระหว่างซ่อมบำรุง

                // Empty state when search yields no matches
                #noResults.no-results-box
                    i.bi.bi-search
                    h5.fw-bold ไม่พบข้อมูลรถยนต์ที่ตรงกับเงื่อนไข
                    p.text-muted กรุณาลองค้นหาด้วยคำอื่น หรือกดเลือก "ทั้งหมด"

        // Modal 1: บันทึกข้อมูลการขอใช้รถ & เลขไมล์เริ่มต้น + ภาพถ่าย
