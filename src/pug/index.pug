                                    input#passengerCount.form-control(type='number', min='1', max='15', value='2')

                            // ส่วนบังคับ: กรอกเลขไมล์เริ่มต้น + ภาพถ่าย
                            .card.border-primary.bg-light
                                .card-body.p-3
                                    h6.fw-bold.text-primary.mb-3
                                        i.bi.bi-speedometer.me-2
                                        | บันทึกเลขไมล์เริ่มต้นตอนยังไม่ขับรถ (Odometer Start) *
                                    .row.g-3
                                        .col-md-6
                                            label.form-label.fw-bold(for='startMileageInput')
                                                | เลขไมล์เริ่มต้นที่แสดงบนหน้าปัด (กิโลเมตร) *
                                            .input-group
                                                input#startMileageInput.form-control.form-control-lg.fw-bold(type='number', required, placeholder='เช่น 48250')
                                                span.input-group-text.bg-white กม.
                                            small.text-muted ตรวจสอบตัวเลขหน้าปัดจริงของรถยนต์คันนี้

                                        .col-md-6
                                            label.form-label.fw-bold
                                                | แนบรูปถ่ายหน้าปัดไมล์เริ่มต้น *
                                            
                                            // กล่องเลือกไฟล์หรือถ่ายรูป
                                            #startPhotoDropzone.photo-upload-dropzone
