                            button.btn.btn-primary.px-4(type='submit')
                                i.bi.bi-play-circle-fill.me-1
                                | ยืนยันเริ่มใช้งานรถยนต์

        // Modal 2: บันทึกเลขไมล์สิ้นสุดหลังใช้รถเสร็จ + ถ่ายรูป + คำนวณเงินค่าเดินทาง
        #returnModal.modal.fade(tabindex='-1', aria-labelledby='returnModalLabel', aria-hidden='true')
            .modal-dialog.modal-dialog-centered.modal-lg
                .modal-content.border-0.shadow
                    .modal-header.bg-success.text-white
                        h5#returnModalLabel.modal-title.d-flex.align-items-center
                            i.bi.bi-check-circle-fill.me-2
                            | ขั้นตอนที่ 2: บันทึกคืนรถ & คำนวณเงินชดเชยค่าเดินทาง
                        button.btn-close.btn-close-white(type='button', data-bs-dismiss='modal', aria-label='Close')
                    form#returnForm
                        .modal-body.p-4
                            // ข้อมูลผู้ขับและรถยนต์
                            .d-flex.justify-content-between.align-items-center.p-3.bg-light.rounded.mb-4.border
                                div
                                    h5.fw-bold.mb-1
                                        span#returnModalPlate.badge.bg-dark.me-2 1กข 8924
