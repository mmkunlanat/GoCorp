doctype html
html(lang='th')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='ระบบเลือกใช้งานรถยนต์ส่วนกลาง GoCorp - เลขทะเบียน รอบต่อภาษี รอบซ่อมบำรุง และคำนวณเงินค่าเดินทางตามระยะทาง')
        meta(name='author', content='GoCorp Fleet Management')

        title GoCorp - ระบบเลือกใช้งานรถยนต์ส่วนกลาง

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Google Fonts (Prompt & Inter)
        link(rel='preconnect', href='https://fonts.googleapis.com')
        link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
        link(href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Prompt:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap', rel='stylesheet')

        // Bootstrap icons
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css', rel='stylesheet')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

