                                                input#endMileageInput.form-control.form-control-lg.fw-bold.text-primary(type='number', required, placeholder='เช่น 48315')
                                                span.input-group-text.bg-white กม.

                                            // กล่องอัปโหลดภาพถ่ายสิ้นสุด
                                            #endPhotoDropzone.photo-upload-dropzone.mt-2
                                                i.bi.bi-camera-fill.dropzone-icon
                                                .dropzone-text คลิกเพื่อถ่ายรูปหรืออัปโหลดภาพไมล์ล่าสุด
                                                .dropzone-subtext ถ่ายภาพหน้าปัดเมื่อใช้รถเสร็จ
