                                                    i.bi.bi-x-lg
                                                span.photo-caption-badge
                                                    i.bi.bi-check-circle-fill.text-success.me-1
                                                    | ภาพถ่ายหน้าปัดหลังใช้เสร็จ

                                            .mt-2.text-end
                                                button#btnDemoEndPhoto.btn.btn-outline-primary.btn-sm.btn-demo-photo(type='button')
                                                    i.bi.bi-image.me-1
